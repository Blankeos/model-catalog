{
  "name": "model-catalog",
  "version": "0.1.2",
  "description": "A tiny JS/TS library and CLI for building AI model catalogs and listing BYOK-available models.",
  "type": "module",
  "license": "MIT",
  "author": "Blankeos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankeos/model-catalog.git"
  },
  "homepage": "https://github.com/blankeos/model-catalog#readme",
  "bugs": {
    "url": "https://github.com/blankeos/model-catalog/issues"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "model-catalog": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run typecheck && bun run test",
    "ci": "bun run typecheck && bun run typecheck:examples && bun run test && bun run build",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:example:react": "bun run --cwd examples/react dev",
    "dev:example:solid": "bun run --cwd examples/solid dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "bun run --cwd examples/react typecheck && bun run --cwd examples/solid typecheck",
    "build:example:snapshot": "node dist/cli.js refresh --out examples/catalog-snapshot.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run ci && changeset publish"
  },
  "keywords": [
    "ai",
    "models",
    "catalog",
    "byok",
    "models.dev",
    "cli"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
